{
  "name": "nibmark",
  "productName": "Nibmark",
  "version": "0.4.1",
  "description": "Markdown note-taking app for developers",
  "author": "Vu Minh Quan",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "verify": "npm run typecheck && npm run build && npm run check:bundle",
    "pack": "electron-vite build && npm run check:bundle && electron-builder --dir",
    "dist": "electron-vite build && npm run check:bundle && electron-builder --publish never"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/pouchdb-browser": "^6.1.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/spark-md5": "^3.0.5",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@vscode/markdown-it-katex": "^1.1.2",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "emojilib": "^4.0.3",
    "events": "^3.3.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.71.0",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.3.0",
    "pouchdb-browser": "^9.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "spark-md5": "^3.0.2",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "zustand": "^5.1.0"
  },
  "build": {
    "appId": "dev.nibmark.app",
    "productName": "Nibmark",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Nibmark reads your notes from Apple Notes only when you choose File → Import from Apple Notes."
      }
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "dmg": {
      "title": "${productName} ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ]
  }
}
